# .htaccess in the document root

RewriteEngine On

# ---------- Canonical redirect (optional) ----------
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[?\s] [NC]
RewriteRule ^ %1 [R=301,L]

# ---------- Internal rewrite: /foo → /foo.html ----------
RewriteCond %{REQUEST_URI} !\.[^./]+$          # no extension
RewriteCond %{REQUEST_FILENAME}.html -f        # file exists
RewriteRule ^(.+)$ $1.html [L]